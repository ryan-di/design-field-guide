---
// Old links point at one long page (index.html#some-id). Send each id to the page that now holds it.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<script is:inline define:vars={{ base }}>
	const id = decodeURIComponent(location.hash.slice(1));
	if (id) {
		fetch(base + 'anchors.json')
			.then((r) => r.json())
			.then((anchors) => {
				if (anchors[id]) location.replace(base + anchors[id] + '/' + location.hash);
			});
	}
</script>
